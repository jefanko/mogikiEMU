<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Mogiki.App.Views.AboutWindow"
        Title="About Mogiki NES Emulator"
        Icon="/Assets/mgkEMU.png"
        Width="520" Height="390"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    
    <Grid RowDefinitions="Auto, *, Auto" Margin="28">
        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16">
            <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource AccentMutedBrush}" VerticalAlignment="Center">
                <Image Source="/Assets/mgkEMU.png" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Mogiki NES" FontSize="23" FontWeight="SemiBold" />
                <TextBlock Text="VERSION 2.0  ·  AVALONIA EDITION" Classes="eyebrow" FontSize="9" />
            </StackPanel>
        </StackPanel>

        <!-- Body -->
        <Border Grid.Row="1" Margin="0,22,0,22" Padding="18" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="A cycle-accurate, hardware-sensitive NES / Famicom emulator re-engineered in C# with Avalonia UI."
                           TextWrapping="Wrap" Classes="muted" FontSize="13" />
                <TextBlock Text="HARDWARE SUPPORT" Classes="eyebrow" Margin="0,6,0,0" />
                <TextBlock Text="• Ricoh 2A03 CPU (6502 core with illegal opcodes support)" Classes="muted" FontSize="12" />
                <TextBlock Text="• Ricoh 2C02 PPU (cycle-accurate rendering &amp; sprite evaluation)" Classes="muted" FontSize="12" />
                <TextBlock Text="• APU 2A03 (pulse 1/2, triangle, noise, DMC channels)" Classes="muted" FontSize="12" />
                <TextBlock Text="• Mappers 0, 1, 2, 4, 5, and 69" Classes="muted" FontSize="12" />
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Button Grid.Row="2" Content="Close" HorizontalAlignment="Right" Width="96" Height="36"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                Click="OnCloseClick" />
    </Grid>
</Window>
